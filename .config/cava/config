[general]

# Auto reload config
live-config = 1
framerate = 165
autosens = 0
sensitivity = 100
scaling = linear # Default, but could try decibel
#0 bars fills the screen
bars = 0
#0 or 1 is best, 0 means they touch
bar_width = 1
bar_spacing = 1
lower_cutoff_freq = 20
higher_cutoff_freq = 20000

[input]
method = pipewire
#without eq (before equalizer kicks in)
source = easyeffects_sink.monitor

#with eq
#source = alsa_output.usb-FIIO_FIIO_KA11-01.analog-stereo.monitor

#microphone
#source = alsa_output.usb-FIIO_FIIO_KA11-01.analog-stereo

[output]
# 'noncurses' is best for performance and frequency labels
method = sdl
channels = mono # best
# frequency on x-axis, otherwise set to "none"
xaxis = frequency

# removes flickering in alacritty terminal emulator.
# defaults to off since the behaviour in other terminal emulators is unknown
; synchronized_sync = 0


[sdl]
# sdl_width = 1024
# sdl_height = 512
# sdl_x = -1
# sdl_y= -1
# bars = 50

[color]
# Gruvbox Dark black background and red foreground
background = "#282828"
foreground = "#cc241d"

[smoothing]
#0-100. 0 is raw with lowest delay.
noise_reduction = 0
#does weird stuff with smoothness idk
monstercat = 0
waves = 0
integral = 0
