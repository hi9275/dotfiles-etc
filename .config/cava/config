[general]

# Auto reload config
live-config = 1
framerate = 165
autosens = 0
sensitivity = 100
max_height = 100

# Default, but could try decibel
scaling = linear

#0 bars fills the screen
bars = 0

# 8 for SDL, otherwise 1
bar_width = 8

# 2 for SDL, otherwise 1
bar_spacing = 2

lower_cutoff_freq = 20
higher_cutoff_freq = 20000

[input]

# Max playback quality from Spotify
sample_rate = 44100
sample_bits = 24


# Linux

# Most important
;method = pipewire
# Without eq (before equalizer kicks in)
;source = easyeffects_sink.monitor

#with eq
#source = alsa_output.usb-FIIO_FIIO_KA11-01.analog-stereo.monitor

#microphone
#source = alsa_output.usb-FIIO_FIIO_KA11-01.analog-stereo

[output]
# 'noncurses' is best for frequency labels
method = sdl

# DOCS: 'mono_option' set mono to either take input from 'left', 'right' or 'average'.
# DOCS: set 'reverse' to 1 to display frequencies the other way around.
channels = mono
mono_option = average

# frequency on x-axis, otherwise set to "none" DOES NOT WORK WITH SDL
xaxis = frequency

# DOCS: removes flickering in alacritty terminal emulator.
# DOCS: defaults to off since the behaviour in other terminal emulators is unknown
; synchronized_sync = 0

sdl_width = 1600
sdl_height = 480

# Default window positioning
sdl_x = -1
sdl_y= -1
# bars = 50

[color]
# Gruvbox Dark black background and red foreground
background = "#282828"
foreground = "#cc241d"

[smoothing]
# 0-100. 0 is practically no delay
noise_reduction = 0

# does weird stuff with smoothness idk
monstercat = 0
waves = 0
integral = 0
